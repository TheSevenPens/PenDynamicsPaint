<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PenDynamicsPaint.Controls"
        x:Class="PenDynamicsPaint.MainWindow"
        Title="PenDynamicsPaint"
        Width="1400" Height="900"
        Background="{DynamicResource Pdl.Pane}">

    <Window.Styles>
        <!-- The brush panel is a column of one-line rows: a label, a control, and a value. Setting
             the shape once here is what lets it be compact: a label stacked above its slider costs
             twice the height and says nothing the inline label does not. -->
        <!-- No fixed height: the row is as tall as the slider inside it wants to be. Forcing it
             shorter clips the thumb, because the Fluent template lays the track out against the
             box rather than centring the thumb in it. -->
        <!-- A fixed height, not a minimum. As a minimum the row was as tall as whatever was in
             it, so any control that asked for more room in one of its states (hovered, pressed,
             focused) pushed itself and the whole column below it down the panel, and the control
             moved out from under the pointer reaching for it.

             A row here holds a label, one control and a value, and 24 is enough for all three.
             Nothing clips: the reason an explicit height used to clip the slider thumb into a dome
             was a 20px Fluent thumb in a 24px box, and the thumb is 11 now. -->
        <Style Selector="Border.row">
            <Setter Property="Height" Value="24" />
        </Style>

        <Style Selector="Border.row > Grid > TextBlock.name">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Pdl.Hint}" />
        </Style>

        <Style Selector="Border.row > Grid > TextBlock.value">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{DynamicResource Pdl.SubtleText}" />
        </Style>

        <!-- A Fluent slider reserves room above and below its track for tick bars this panel
             does not use, and the reservation is inside the template: lifting MinHeight does not
             reach it, and setting an explicit Height clips the thumb into a dome because the
             template lays the track out against the box rather than centring the thumb in it.
             A negative margin takes the space back from outside. Nothing clips, because nothing
             in the column clips. -->
        <Style Selector="Border.row > Grid > Slider">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0,-7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Fluent's slider thumb is sized for a touchscreen: a 20px disc on a 2px track, which on
             a panel of one-line rows reads as a row of buttons rather than a row of sliders, and
             hides the part of the track it is meant to point at. -->
        <Style Selector="Slider:horizontal /template/ Thumb">
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <Setter Property="MinWidth" Value="11" />
            <Setter Property="MinHeight" Value="11" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!-- Scaled, not resized. Growing the thumb on hover changes how much room it asks for,
             and the rows here are as tall as their content: the row grew by two pixels and took
             everything below it down the panel with it, so the slider moved under the pointer that
             was reaching for it. A transform is drawn at a different size and laid out at the same
             one. -->
        <Style Selector="Slider:horizontal /template/ Thumb">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        </Style>

        <Style Selector="Slider:horizontal /template/ Thumb:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.25)" />
        </Style>

        <Style Selector="Slider:horizontal /template/ Thumb:pressed">
            <Setter Property="RenderTransform" Value="scale(1.1)" />
        </Style>

        <!-- Sections that are read less often than they are set. They used to expand in place,
             which pushed everything below them down the panel and made it scroll: on a tablet the
             brush settings were already taller than the screen, and opening two of them meant
             hunting for the size slider. They fly out beside the panel instead, the way Rebelle
             does it, so the panel keeps its shape and the section opens next to what it belongs to.

             The value stays on the button, so a closed section still says what it holds. -->
        <Style Selector="Button.section">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style Selector="FlyoutPresenter.panel">
            <Setter Property="Padding" Value="12" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="320" />
        </Style>

    </Window.Styles>

    <DockPanel>
        <!-- The commands, where an application keeps them. What was here before was a row of
             buttons and two combo boxes, which does not scale: every new command was another
             button competing for the same strip, and the pen backend sat permanently in view
             although it is chosen once and then left alone. That one now lives in Tools > Options.

             Everything about the mark belongs to a brush and is on the left; everything about
             where it goes belongs to a layer and is on the right. This holds what is neither. -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource Pdl.Surface}">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGesture="Ctrl+N" Click="New_Click" />
                <Separator />
                <MenuItem Header="_Open..." InputGesture="Ctrl+O" Click="Open_Click" />
                <MenuItem Header="_Save" InputGesture="Ctrl+S" Click="Save_Click" />
                <MenuItem Header="Save _As..." Click="SaveAs_Click" />
                <Separator />
                <MenuItem Header="_Export image..." InputGesture="Ctrl+E" Click="Export_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGesture="Ctrl+Z" Click="Undo_Click" />
                <Separator />
                <MenuItem Header="Clear _layer" InputGesture="Delete" Click="ClearLayer_Click" />
                <MenuItem Header="Clear _document" Click="ClearDocument_Click" />
            </MenuItem>

            <MenuItem Header="_Layer">
                <MenuItem Header="_Add" Click="AddLayer_Click" />
                <MenuItem Header="_Delete" Click="DeleteLayer_Click" />
                <Separator />
                <MenuItem Header="_Merge down" Click="MergeLayer_Click" />
                <Separator />
                <MenuItem Header="Raise" Click="RaiseLayer_Click" />
                <MenuItem Header="Lower" Click="LowerLayer_Click" />
            </MenuItem>

            <!-- Where a brush's engine is chosen: when the brush is made. It used to be a combo
                 box among the settings, which read as though any brush could be switched to any
                 engine. It could, and the result was misleading in both directions: a taper
                 switched to MyPaint quietly became a default round dab with nothing of the original
                 in it, and a MyPaint brush switched to taper drew from settings its file had never
                 set. A brush is its engine rather than a brush that has one. -->
            <MenuItem Header="_Brush">
                <MenuItem Header="New _taper brush" Click="NewTaperBrush_Click" />
                <MenuItem Header="New _dabs brush" Click="NewDabsBrush_Click" />
                <Separator />
                <MenuItem Header="Load _MyPaint brush..." Click="NewMyPaintBrush_Click" />
            </MenuItem>

            <MenuItem Header="_Tools">
                <MenuItem Header="_Options..." Click="Options_Click" />
            </MenuItem>
        </Menu>

        <!-- The ink, and only the ink. A fixed set rather than a picker: the point is to have more
             than one colour at all, and until recently there was exactly one, which made a smudge
             brush impossible to tell apart from an ordinary one, since it could only ever pick up
             and lay down the same dark navy everything else was drawn in.

             On a strip of its own because it is reached for constantly, which is the one thing a
             toolbar is good for. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Pdl.Surface}"
                BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="0,0,0,1"
                Padding="12,0">
            <StackPanel Orientation="Horizontal" Spacing="4" Height="34" VerticalAlignment="Center"
                        x:Name="SwatchRow" />
        </Border>

        <!-- Along the bottom, where a status line goes. It was a pill floating in the toolbar,
             which put transient messages about a saved file next to the controls rather than out
             of the way of them. -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Pdl.Surface}"
                BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="0,1,0,0"
                Padding="12,0">
            <TextBlock x:Name="StatusLabel" FontSize="11" Height="24" VerticalAlignment="Center"
                       Foreground="{DynamicResource Pdl.SubtleText}" />
        </Border>

        <!-- Brushes on the left, layers on the right: one panel for what the mark is made of, one
             for where it goes. Everything here edits the selected brush and nothing else. -->
        <Border DockPanel.Dock="Left" Width="244" Background="{DynamicResource Pdl.Surface}"
                BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="0,0,1,0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10,8" Spacing="3">

                    <ComboBox x:Name="BrushCombo" HorizontalAlignment="Stretch" Height="30"
                              Margin="0,0,0,4" />

                    <!-- What the ink does between two samples. Next to the engine because the two
                         together decide the shape of a mark: one lays it down, the other says
                         along what path. -->
                    <Border Classes="row">
                        <Grid ColumnDefinitions="58,*">
                            <TextBlock Grid.Column="0" Classes="name" Text="Path" />
                            <ComboBox Grid.Column="1" x:Name="InterpolationCombo" Height="24"
                                      FontSize="11" Padding="6,0" VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch" />
                        </Grid>
                    </Border>

                    <!-- On the brush now rather than on the document. It sat on the document
                         because it decides how a stroke reaches the layer rather than what the mark
                         looks like, which is the same question whichever brush drew it. In use it
                         is not: a marker wants its overlaps flattened and a dry-media brush wants
                         them to build up. -->
                    <Border Classes="row">
                        <Grid ColumnDefinitions="58,*">
                            <TextBlock Grid.Column="0" Classes="name" Text="Stroke" />
                            <ComboBox Grid.Column="1" x:Name="CompositingCombo" Height="24"
                                      FontSize="11" Padding="6,0" VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch" />
                        </Grid>
                    </Border>

                    <Border Classes="row" x:Name="DrivesRow">
                        <Grid ColumnDefinitions="58,*">
                            <TextBlock Grid.Column="0" Classes="name" Text="Pressure" />
                            <ComboBox Grid.Column="1" x:Name="DrivesCombo" Height="24"
                                      FontSize="11" Padding="6,0" VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch" />
                        </Grid>
                    </Border>

                    <!-- Only for a MyPaint brush, where the file decides what the sliders above
                         would otherwise say. Shows what was loaded and how much of it went
                         unused, so a brush that wanted smudge does not look like one that did
                         not. -->
                    <Border Classes="row" x:Name="MyPaintRow">
                        <Grid ColumnDefinitions="58,*,auto">
                            <TextBlock Grid.Column="0" Classes="name" Text="Brush file" />
                            <TextBlock Grid.Column="1" x:Name="MyPaintLabel" Classes="value"
                                       TextAlignment="Left" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <!-- Changes which file this brush is. Brush > Load MyPaint brush
                                 is the other thing, and that one makes a new brush. -->
                            <Button Grid.Column="2" Content="Change..." FontSize="10" Padding="6,1"
                                    VerticalAlignment="Center" Click="LoadMyPaintBrush_Click" />
                        </Grid>
                    </Border>

                    <Border Classes="row" x:Name="SizeRow">
                        <Grid ColumnDefinitions="58,*,36">
                            <TextBlock Grid.Column="0" Classes="name" Text="Size" />
                            <Slider Grid.Column="1" x:Name="SizeSlider" Minimum="1" Maximum="200" />
                            <TextBlock Grid.Column="2" x:Name="SizeLabel" Classes="value" />
                        </Grid>
                    </Border>

                    <!-- Only the dab engine has marks to space, so the row follows the engine
                         rather than sitting inert. -->
                    <Border Classes="row" x:Name="SpacingRow">
                        <Grid ColumnDefinitions="58,*,36">
                            <TextBlock Grid.Column="0" Classes="name" Text="Spacing" />
                            <Slider Grid.Column="1" x:Name="SpacingSlider" Minimum="0.02" Maximum="2.0" />
                            <TextBlock Grid.Column="2" x:Name="SpacingLabel" Classes="value" />
                        </Grid>
                    </Border>

                    <Border Classes="row" x:Name="OpacityRow">
                        <Grid ColumnDefinitions="58,*,36">
                            <TextBlock Grid.Column="0" Classes="name" Text="Opacity" />
                            <Slider Grid.Column="1" x:Name="BrushOpacitySlider" Minimum="0" Maximum="100" />
                            <TextBlock Grid.Column="2" x:Name="BrushOpacityLabel" Classes="value" />
                        </Grid>
                    </Border>

                    <Button Classes="section" x:Name="CurveSection">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Pressure curve" FontSize="11"
                                       Foreground="{DynamicResource Pdl.GroupLabel}" />
                            <TextBlock x:Name="CurveSummary" FontSize="11"
                                       Foreground="{DynamicResource Pdl.SubtleText}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="RightEdgeAlignedTop" FlyoutPresenterClasses="panel">
                        <StackPanel Width="250" Spacing="3">

                    <!-- Three presets, because most of the time one of them is the answer and
                         nobody wants to solve for an exponent to get a soft nib. -->
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2">
                        <Button x:Name="CurveSoftButton" Content="Soft" FontSize="10"
                                Padding="8,2" Click="CurveSoft_Click" />
                        <Button x:Name="CurveDefaultButton" Content="Default" FontSize="10"
                                Padding="8,2" Click="CurveDefault_Click" />
                        <Button x:Name="CurveHardButton" Content="Hard" FontSize="10"
                                Padding="8,2" Click="CurveHard_Click" />
                    </StackPanel>

                    <!-- Drawn rather than described. Three numbers say very little about how a
                         brush will feel, and the shape says it at a glance.

                         Square, because both axes are the same quantity on the same scale: what
                         the pen reports against what the brush does with it. Drawn wide, equal
                         pressures sat at unequal distances from the diagonal and the curve looked
                         steeper than it is. -->
                    <Border Width="218" Height="218" HorizontalAlignment="Left"
                            Background="{DynamicResource Pdl.PlotField}"
                            BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="1"
                            CornerRadius="3" Margin="0,2">
                        <Canvas x:Name="CurvePlot" ClipToBounds="True">
                            <!-- Declared here rather than built in code so the theme resolves
                                 their colours. A brush looked up from code-behind has to name a
                                 theme variant to find one of these, and a shape whose Stroke came
                                 back null draws nothing at all: an empty plot, with no error. -->
                            <Line x:Name="CurveDiagonal" Stroke="{DynamicResource Pdl.Divider}"
                                  StrokeThickness="1" StrokeDashArray="3,3" />
                            <!-- No Fill. Setting one makes Avalonia close the figure, and the
                                 closing segment is stroked too: a straight line from the last
                                 point back to the first, which looks exactly like a second
                                 reference diagonal. -->
                            <Polyline x:Name="CurveLine" Stroke="{DynamicResource Pdl.CurveInk}"
                                      StrokeThickness="2" />

                            <!-- Where the pen is on the curve, right now. The numbers say what the
                                 curve is; this says what it is doing to the pen in your hand, which
                                 is the thing that is hard to picture and easy to feel. -->
                            <Ellipse x:Name="CurveDot" Width="9" Height="9" IsVisible="False"
                                     Fill="{DynamicResource Pdl.CurveInk}" />
                            <Line x:Name="CurveDotDrop" Stroke="{DynamicResource Pdl.CurveInk}"
                                  StrokeThickness="1" StrokeDashArray="2,2" Opacity="0.5"
                                  IsVisible="False" />
                        </Canvas>
                    </Border>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="58,*,36">
                            <TextBlock Grid.Column="0" Classes="name" Text="Start" />
                            <Slider Grid.Column="1" x:Name="CurveStartSlider" Minimum="0" Maximum="1" />
                            <TextBlock Grid.Column="2" x:Name="CurveStartLabel" Classes="value" />
                        </Grid>
                    </Border>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="58,*,36">
                            <TextBlock Grid.Column="0" Classes="name" Text="End" />
                            <Slider Grid.Column="1" x:Name="CurveEndSlider" Minimum="0" Maximum="1" />
                            <TextBlock Grid.Column="2" x:Name="CurveEndLabel" Classes="value" />
                        </Grid>
                    </Border>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="58,*,36">
                            <TextBlock Grid.Column="0" Classes="name" Text="Curve" />
                            <Slider Grid.Column="1" x:Name="CurveExponentSlider" Minimum="0.1" Maximum="4" />
                            <TextBlock Grid.Column="2" x:Name="CurveExponentLabel" Classes="value" />
                        </Grid>
                    </Border>

                        </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Two reaches, not one with a switch. Position and pressure are different
                         problems. A shaky hand wants its path steadied and its pressure left
                         alone; a noisy sensor wants the opposite. -->
                    <Button Classes="section" x:Name="SmoothingSection">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Smoothing" FontSize="11"
                                       Foreground="{DynamicResource Pdl.GroupLabel}" />
                            <TextBlock x:Name="SmoothingSummary" FontSize="11"
                                       Foreground="{DynamicResource Pdl.SubtleText}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="RightEdgeAlignedTop" FlyoutPresenterClasses="panel">
                        <StackPanel Width="250" Spacing="3">

                    <Border Classes="row">
                        <Grid ColumnDefinitions="58,*,36">
                            <TextBlock Grid.Column="0" Classes="name" Text="Position" />
                            <Slider Grid.Column="1" x:Name="PositionSmoothingSlider"
                                    Minimum="0" Maximum="200" />
                            <TextBlock Grid.Column="2" x:Name="PositionSmoothingLabel" Classes="value" />
                        </Grid>
                    </Border>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="58,*,36">
                            <TextBlock Grid.Column="0" Classes="name" Text="Pressure" />
                            <Slider Grid.Column="1" x:Name="PressureSmoothingSlider"
                                    Minimum="0" Maximum="200" />
                            <TextBlock Grid.Column="2" x:Name="PressureSmoothingLabel" Classes="value" />
                        </Grid>
                    </Border>

                    <!-- Its own reach, like the two above. A brush driven by tilt wants it
                         steadied whether or not the line did, and tilt arrives dirtier than either
                         of them: tablets quantise it to whole degrees. -->
                    <Border Classes="row">
                        <Grid ColumnDefinitions="58,*,36">
                            <TextBlock Grid.Column="0" Classes="name" Text="Tilt" />
                            <Slider Grid.Column="1" x:Name="TiltSmoothingSlider"
                                    Minimum="0" Maximum="200" />
                            <TextBlock Grid.Column="2" x:Name="TiltSmoothingLabel" Classes="value" />
                        </Grid>
                    </Border>

                    <Border Classes="row" x:Name="TailRow">
                        <Grid ColumnDefinitions="58,*,36">
                            <TextBlock Grid.Column="0" Classes="name" Text="Tail" />
                            <Slider Grid.Column="1" x:Name="TailSlider" Minimum="0" Maximum="1" />
                            <TextBlock Grid.Column="2" x:Name="TailLabel" Classes="value" />
                        </Grid>
                    </Border>
                        </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Docked rather than floating: the stack is the document's structure, and it is read
             far more often than it is changed. Top of the list is top of the stack, which is what
             every paint application does; PaintSession.Layers is the other way round, because that
             is composite order. The reversal lives here so it can be got wrong in one place. -->
        <Border DockPanel.Dock="Right" Width="230" Background="{DynamicResource Pdl.Surface}"
                BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="1,0,0,0">
            <DockPanel Margin="12">
                <TextBlock DockPanel.Dock="Top" Text="Layers" FontSize="12" FontWeight="SemiBold"
                           Margin="0,0,0,8" Foreground="{DynamicResource Pdl.GroupLabel}" />

                <!-- Above the list, not below it. The list grows downwards as layers are added,
                     so anything under it moves every time, and these are the two controls
                     reached for most, which should not be the two that wander.

                     Add is the only button. Everything else that can be done to a layer is done to
                     a particular layer, so it belongs on that layer rather than on a row of buttons
                     acting at a distance on whichever one happens to be selected. Add is the
                     exception because it acts on the stack rather than on a layer. -->
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="AddLayerButton" Content="Add layer" FontSize="11"
                                Padding="8,4" Click="AddLayer_Click" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Opacity" FontSize="11"
                                       Foreground="{DynamicResource Pdl.Hint}" />
                            <TextBlock x:Name="LayerOpacityLabel" FontSize="11"
                                       Foreground="{DynamicResource Pdl.SubtleText}" />
                        </StackPanel>
                        <Slider x:Name="LayerOpacitySlider" Minimum="0" Maximum="100" Value="100" />
                    </StackPanel>
                </StackPanel>

                <ListBox x:Name="LayerList" Background="Transparent"
                         BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="1" />
            </DockPanel>
        </Border>

        <controls:PaintCanvasView x:Name="PaintView" />
    </DockPanel>
</Window>
