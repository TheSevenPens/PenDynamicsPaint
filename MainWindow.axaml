<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PenDynamicsPaint.Controls"
        x:Class="PenDynamicsPaint.MainWindow"
        Title="PenDynamicsPaint"
        Width="1400" Height="900"
        Background="{DynamicResource Pdl.Pane}">

    <Window.Styles>
        <!-- The brush panel is a column of one-line rows: a label, a control, and a value. Setting
             the shape once here is what lets it be compact: a label stacked above its slider costs
             twice the height and says nothing the inline label does not. -->
        <!-- No fixed height: the row is as tall as the slider inside it wants to be. Forcing it
             shorter clips the thumb, because the Fluent template lays the track out against the
             box rather than centring the thumb in it. -->
        <Style Selector="Border.row">
            <Setter Property="MinHeight" Value="24" />
        </Style>

        <Style Selector="Border.row > Grid > TextBlock.name">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Pdl.Hint}" />
        </Style>

        <Style Selector="Border.row > Grid > TextBlock.value">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{DynamicResource Pdl.SubtleText}" />
        </Style>

        <!-- A Fluent slider reserves room above and below its track for tick bars this panel
             does not use, and the reservation is inside the template: lifting MinHeight does not
             reach it, and setting an explicit Height clips the thumb into a dome because the
             template lays the track out against the box rather than centring the thumb in it.
             A negative margin takes the space back from outside. Nothing clips, because nothing
             in the column clips. -->
        <Style Selector="Border.row > Grid > Slider">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0,-7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Sections that are read less often than they are set. Collapsed, but with their values
             on the header, so folding one away does not mean losing sight of what it holds. -->
        <Style Selector="Expander.section">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Padding" Value="0,2,0,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Expander.section /template/ ToggleButton#PART_toggle">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <Style Selector="Expander.section > StackPanel">
            <Setter Property="Spacing" Value="3" />
        </Style>

    </Window.Styles>

    <DockPanel>
        <!-- Only what is neither a brush nor a layer. Everything about the mark, smoothing
             included, belongs to a brush; a bar is the wrong shape for something you switch
             between rather than set once. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Pdl.Surface}"
                BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="0,0,0,1"
                Padding="16,0">
            <StackPanel Orientation="Horizontal" Spacing="24" Height="48" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Pen" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource Pdl.Hint}" />
                    <ComboBox x:Name="ApiCombo" Width="160" Height="30" VerticalAlignment="Center" />
                </StackPanel>

                <!-- A document setting, not a brush one: it decides how a stroke reaches the
                     layer, which is the same question whichever brush drew it. -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Stroke" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource Pdl.Hint}" />
                    <ComboBox x:Name="CompositingCombo" Width="110" Height="30" VerticalAlignment="Center" />
                </StackPanel>

                <Border Background="{DynamicResource Pdl.ActiveFill}" CornerRadius="4" Padding="8,3"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="StatusLabel" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource Pdl.SubtleText}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Brushes on the left, layers on the right: one panel for what the mark is made of, one
             for where it goes. Everything here edits the selected brush and nothing else. -->
        <Border DockPanel.Dock="Left" Width="244" Background="{DynamicResource Pdl.Surface}"
                BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="0,0,1,0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10,8" Spacing="3">

                    <ComboBox x:Name="BrushCombo" HorizontalAlignment="Stretch" Height="30"
                              Margin="0,0,0,4" />

                    <Border Classes="row">
                        <Grid ColumnDefinitions="58,*">
                            <TextBlock Grid.Column="0" Classes="name" Text="Engine" />
                            <ComboBox Grid.Column="1" x:Name="EngineCombo" Height="24"
                                      FontSize="11" Padding="6,0" VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch" />
                        </Grid>
                    </Border>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="58,*">
                            <TextBlock Grid.Column="0" Classes="name" Text="Pressure" />
                            <ComboBox Grid.Column="1" x:Name="DrivesCombo" Height="24"
                                      FontSize="11" Padding="6,0" VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch" />
                        </Grid>
                    </Border>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="58,*,36">
                            <TextBlock Grid.Column="0" Classes="name" Text="Size" />
                            <Slider Grid.Column="1" x:Name="SizeSlider" Minimum="1" Maximum="200" />
                            <TextBlock Grid.Column="2" x:Name="SizeLabel" Classes="value" />
                        </Grid>
                    </Border>

                    <!-- Only the dab engine has marks to space, so the row follows the engine
                         rather than sitting inert. -->
                    <Border Classes="row" x:Name="SpacingRow">
                        <Grid ColumnDefinitions="58,*,36">
                            <TextBlock Grid.Column="0" Classes="name" Text="Spacing" />
                            <Slider Grid.Column="1" x:Name="SpacingSlider" Minimum="0.02" Maximum="2.0" />
                            <TextBlock Grid.Column="2" x:Name="SpacingLabel" Classes="value" />
                        </Grid>
                    </Border>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="58,*,36">
                            <TextBlock Grid.Column="0" Classes="name" Text="Opacity" />
                            <Slider Grid.Column="1" x:Name="BrushOpacitySlider" Minimum="0" Maximum="100" />
                            <TextBlock Grid.Column="2" x:Name="BrushOpacityLabel" Classes="value" />
                        </Grid>
                    </Border>

                    <Expander Classes="section" x:Name="CurveSection">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Pressure curve" FontSize="11"
                                           Foreground="{DynamicResource Pdl.GroupLabel}" />
                                <TextBlock x:Name="CurveSummary" FontSize="11"
                                           Foreground="{DynamicResource Pdl.SubtleText}" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel>

                    <!-- Drawn rather than described. Three numbers say very little about how a
                         brush will feel, and the shape says it at a glance. -->
                    <Border Height="78" Background="{DynamicResource Pdl.PlotField}"
                            BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="1"
                            CornerRadius="3" Margin="0,2">
                        <Canvas x:Name="CurvePlot" ClipToBounds="True">
                            <!-- Declared here rather than built in code so the theme resolves
                                 their colours. A brush looked up from code-behind has to name a
                                 theme variant to find one of these, and a shape whose Stroke came
                                 back null draws nothing at all: an empty plot, with no error. -->
                            <Line x:Name="CurveDiagonal" Stroke="{DynamicResource Pdl.Divider}"
                                  StrokeThickness="1" StrokeDashArray="3,3" />
                            <!-- No Fill. Setting one makes Avalonia close the figure, and the
                                 closing segment is stroked too: a straight line from the last
                                 point back to the first, which looks exactly like a second
                                 reference diagonal. -->
                            <Polyline x:Name="CurveLine" Stroke="{DynamicResource Pdl.CurveInk}"
                                      StrokeThickness="2" />
                        </Canvas>
                    </Border>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="58,*,36">
                            <TextBlock Grid.Column="0" Classes="name" Text="Start" />
                            <Slider Grid.Column="1" x:Name="CurveStartSlider" Minimum="0" Maximum="1" />
                            <TextBlock Grid.Column="2" x:Name="CurveStartLabel" Classes="value" />
                        </Grid>
                    </Border>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="58,*,36">
                            <TextBlock Grid.Column="0" Classes="name" Text="End" />
                            <Slider Grid.Column="1" x:Name="CurveEndSlider" Minimum="0" Maximum="1" />
                            <TextBlock Grid.Column="2" x:Name="CurveEndLabel" Classes="value" />
                        </Grid>
                    </Border>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="58,*,36">
                            <TextBlock Grid.Column="0" Classes="name" Text="Curve" />
                            <Slider Grid.Column="1" x:Name="CurveExponentSlider" Minimum="0.1" Maximum="4" />
                            <TextBlock Grid.Column="2" x:Name="CurveExponentLabel" Classes="value" />
                        </Grid>
                    </Border>

                        </StackPanel>
                    </Expander>

                    <!-- Two reaches, not one with a switch. Position and pressure are different
                         problems. A shaky hand wants its path steadied and its pressure left
                         alone; a noisy sensor wants the opposite. -->
                    <Expander Classes="section" x:Name="SmoothingSection">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Smoothing" FontSize="11"
                                           Foreground="{DynamicResource Pdl.GroupLabel}" />
                                <TextBlock x:Name="SmoothingSummary" FontSize="11"
                                           Foreground="{DynamicResource Pdl.SubtleText}" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="58,*,36">
                            <TextBlock Grid.Column="0" Classes="name" Text="Position" />
                            <Slider Grid.Column="1" x:Name="PositionSmoothingSlider"
                                    Minimum="0" Maximum="200" />
                            <TextBlock Grid.Column="2" x:Name="PositionSmoothingLabel" Classes="value" />
                        </Grid>
                    </Border>

                    <Border Classes="row">
                        <Grid ColumnDefinitions="58,*,36">
                            <TextBlock Grid.Column="0" Classes="name" Text="Pressure" />
                            <Slider Grid.Column="1" x:Name="PressureSmoothingSlider"
                                    Minimum="0" Maximum="200" />
                            <TextBlock Grid.Column="2" x:Name="PressureSmoothingLabel" Classes="value" />
                        </Grid>
                    </Border>

                    <Border Classes="row" x:Name="TailRow">
                        <Grid ColumnDefinitions="58,*,36">
                            <TextBlock Grid.Column="0" Classes="name" Text="Tail" />
                            <Slider Grid.Column="1" x:Name="TailSlider" Minimum="0" Maximum="1" />
                            <TextBlock Grid.Column="2" x:Name="TailLabel" Classes="value" />
                        </Grid>
                    </Border>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Docked rather than floating: the stack is the document's structure, and it is read
             far more often than it is changed. Top of the list is top of the stack, which is what
             every paint application does; PaintSession.Layers is the other way round, because that
             is composite order. The reversal lives here so it can be got wrong in one place. -->
        <Border DockPanel.Dock="Right" Width="230" Background="{DynamicResource Pdl.Surface}"
                BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="1,0,0,0">
            <DockPanel Margin="12">
                <TextBlock DockPanel.Dock="Top" Text="Layers" FontSize="12" FontWeight="SemiBold"
                           Margin="0,0,0,8" Foreground="{DynamicResource Pdl.GroupLabel}" />

                <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="AddLayerButton" Content="Add" FontSize="11" Padding="8,4"
                                Click="AddLayer_Click" />
                        <Button x:Name="DeleteLayerButton" Content="Delete" FontSize="11" Padding="8,4"
                                Click="DeleteLayer_Click" />
                        <Button x:Name="MergeLayerButton" Content="Merge down" FontSize="11" Padding="8,4"
                                Click="MergeLayer_Click" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="RaiseLayerButton" Content="Raise" FontSize="11" Padding="8,4"
                                Click="RaiseLayer_Click" />
                        <Button x:Name="LowerLayerButton" Content="Lower" FontSize="11" Padding="8,4"
                                Click="LowerLayer_Click" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Name" FontSize="11" Foreground="{DynamicResource Pdl.Hint}" />
                        <TextBox x:Name="LayerNameBox" FontSize="12" Height="28" Padding="6,2" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Opacity" FontSize="11"
                                       Foreground="{DynamicResource Pdl.Hint}" />
                            <TextBlock x:Name="LayerOpacityLabel" FontSize="11"
                                       Foreground="{DynamicResource Pdl.SubtleText}" />
                        </StackPanel>
                        <Slider x:Name="LayerOpacitySlider" Minimum="0" Maximum="100" Value="100" />
                    </StackPanel>
                </StackPanel>

                <ListBox x:Name="LayerList" Background="Transparent"
                         BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="1" />
            </DockPanel>
        </Border>

        <controls:PaintCanvasView x:Name="PaintView" />
    </DockPanel>
</Window>
