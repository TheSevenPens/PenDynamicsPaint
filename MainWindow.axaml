<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PenDynamicsPaint.Controls"
        x:Class="PenDynamicsPaint.MainWindow"
        Title="PenDynamicsPaint"
        Width="1400" Height="900"
        Background="{DynamicResource Pdl.Pane}">

    <DockPanel>
        <!-- Only what is not a brush and not a layer. Size, spacing, the pressure target and the
             curve used to live here; they belong to a brush, and a bar is the wrong shape for
             something you switch between rather than set once. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Pdl.Surface}"
                BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="0,0,0,1"
                Padding="16,0">
            <StackPanel Orientation="Horizontal" Spacing="24" Height="56" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Pen" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource Pdl.Hint}" />
                    <ComboBox x:Name="ApiCombo" Width="160" Height="32" VerticalAlignment="Center" />
                </StackPanel>

                <!-- A document setting, not a brush one: it decides how a stroke reaches the
                     layer, which is the same question whichever brush drew it. -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Stroke" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource Pdl.Hint}" />
                    <ComboBox x:Name="CompositingCombo" Width="110" Height="32" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Here rather than in the brush panel because it is about the hand, not the
                     mark: it changes where the pen is taken to have been, and every brush drawing
                     that path gets the same benefit. Krita puts it on the tool for the same
                     reason. Opens at zero, so what you see first is what the pen did; Krita's
                     default is 50 and is one slider move away. -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Smoothing" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource Pdl.Hint}" />
                    <Slider x:Name="SmoothingSlider" Width="120" Minimum="0" Maximum="200" Value="0"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="SmoothingLabel" Width="34" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource Pdl.SubtleText}" />
                </StackPanel>

                <StackPanel x:Name="SmoothingExtras" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Text="Tail" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource Pdl.Hint}" />
                    <Slider x:Name="TailSlider" Width="80" Minimum="0" Maximum="1" Value="0.15"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="TailLabel" Width="30" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource Pdl.SubtleText}" />
                    <CheckBox x:Name="SmoothPressureCheck" Content="Pressure too" FontSize="12"
                              VerticalAlignment="Center" />
                </StackPanel>

                <Border Background="{DynamicResource Pdl.ActiveFill}" CornerRadius="4" Padding="8,3"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="StatusLabel" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource Pdl.SubtleText}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Brushes on the left, layers on the right: one panel for what the mark is made of, one
             for where it goes. Everything here edits the selected brush and nothing else, which is
             the point of the whole change: these were application settings, so a brush you
             switched to could not bring its own. -->
        <Border DockPanel.Dock="Left" Width="256" Background="{DynamicResource Pdl.Surface}"
                BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="0,0,1,0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12" Spacing="12">
                    <TextBlock Text="Brush" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Pdl.GroupLabel}" />

                    <ComboBox x:Name="BrushCombo" HorizontalAlignment="Stretch" Height="32" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Engine" FontSize="11"
                                   Foreground="{DynamicResource Pdl.Hint}" />
                        <ComboBox x:Name="EngineCombo" HorizontalAlignment="Stretch" Height="32" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Size" FontSize="11"
                                       Foreground="{DynamicResource Pdl.Hint}" />
                            <TextBlock x:Name="SizeLabel" FontSize="11"
                                       Foreground="{DynamicResource Pdl.SubtleText}" />
                        </StackPanel>
                        <Slider x:Name="SizeSlider" Minimum="1" Maximum="200" Value="40" />
                    </StackPanel>

                    <!-- Only the dab engine has marks to space, so the control follows the engine
                         rather than sitting inert. -->
                    <StackPanel x:Name="SpacingPanel" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Spacing" FontSize="11"
                                       Foreground="{DynamicResource Pdl.Hint}" />
                            <TextBlock x:Name="SpacingLabel" FontSize="11"
                                       Foreground="{DynamicResource Pdl.SubtleText}" />
                        </StackPanel>
                        <Slider x:Name="SpacingSlider" Minimum="0.02" Maximum="2.0" Value="0.1" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Opacity" FontSize="11"
                                       Foreground="{DynamicResource Pdl.Hint}" />
                            <TextBlock x:Name="BrushOpacityLabel" FontSize="11"
                                       Foreground="{DynamicResource Pdl.SubtleText}" />
                        </StackPanel>
                        <Slider x:Name="BrushOpacitySlider" Minimum="0" Maximum="100" Value="100" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Pressure drives" FontSize="11"
                                   Foreground="{DynamicResource Pdl.Hint}" />
                        <ComboBox x:Name="DrivesCombo" HorizontalAlignment="Stretch" Height="32" />
                    </StackPanel>

                    <Rectangle Height="1" Fill="{DynamicResource Pdl.Divider}" Margin="0,4" />

                    <TextBlock Text="Pressure curve" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Pdl.GroupLabel}" />

                    <!-- Drawn rather than described. Three numbers say very little about how a
                         brush will feel, and the shape says it at a glance. -->
                    <Border Height="120" Background="{DynamicResource Pdl.PlotField}"
                            BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="1"
                            CornerRadius="3">
                        <Canvas x:Name="CurvePlot" ClipToBounds="True">
                            <!-- Declared here rather than built in code so the theme resolves
                                 their colours. A brush looked up from code-behind has to name a
                                 theme variant to find one of these, and a shape whose Stroke came
                                 back null draws nothing at all: an empty plot, with no error. -->
                            <Line x:Name="CurveDiagonal" Stroke="{DynamicResource Pdl.Divider}"
                                  StrokeThickness="1" StrokeDashArray="3,3" />
                            <!-- No Fill. Setting one makes Avalonia close the figure, and the
                                 closing segment is stroked too: a straight line from the last
                                 point back to the first, which looks exactly like a second
                                 reference diagonal. -->
                            <Polyline x:Name="CurveLine" Stroke="{DynamicResource Pdl.CurveInk}"
                                      StrokeThickness="2" />
                        </Canvas>
                    </Border>

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Start" FontSize="11"
                                       Foreground="{DynamicResource Pdl.Hint}" />
                            <TextBlock x:Name="CurveStartLabel" FontSize="11"
                                       Foreground="{DynamicResource Pdl.SubtleText}" />
                        </StackPanel>
                        <Slider x:Name="CurveStartSlider" Minimum="0" Maximum="1" Value="0" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="End" FontSize="11"
                                       Foreground="{DynamicResource Pdl.Hint}" />
                            <TextBlock x:Name="CurveEndLabel" FontSize="11"
                                       Foreground="{DynamicResource Pdl.SubtleText}" />
                        </StackPanel>
                        <Slider x:Name="CurveEndSlider" Minimum="0" Maximum="1" Value="1" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Exponent" FontSize="11"
                                       Foreground="{DynamicResource Pdl.Hint}" />
                            <TextBlock x:Name="CurveExponentLabel" FontSize="11"
                                       Foreground="{DynamicResource Pdl.SubtleText}" />
                        </StackPanel>
                        <Slider x:Name="CurveExponentSlider" Minimum="0.1" Maximum="4" Value="1" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Docked rather than floating: the stack is the document's structure, and it is read
             far more often than it is changed. Top of the list is top of the stack, which is what
             every paint application does; PaintSession.Layers is the other way round, because that
             is composite order. The reversal lives here so it can be got wrong in one place. -->
        <Border DockPanel.Dock="Right" Width="230" Background="{DynamicResource Pdl.Surface}"
                BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="1,0,0,0">
            <DockPanel Margin="12">
                <TextBlock DockPanel.Dock="Top" Text="Layers" FontSize="12" FontWeight="SemiBold"
                           Margin="0,0,0,8" Foreground="{DynamicResource Pdl.GroupLabel}" />

                <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="AddLayerButton" Content="Add" FontSize="11" Padding="8,4"
                                Click="AddLayer_Click" />
                        <Button x:Name="DeleteLayerButton" Content="Delete" FontSize="11" Padding="8,4"
                                Click="DeleteLayer_Click" />
                        <Button x:Name="MergeLayerButton" Content="Merge down" FontSize="11" Padding="8,4"
                                Click="MergeLayer_Click" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="RaiseLayerButton" Content="Raise" FontSize="11" Padding="8,4"
                                Click="RaiseLayer_Click" />
                        <Button x:Name="LowerLayerButton" Content="Lower" FontSize="11" Padding="8,4"
                                Click="LowerLayer_Click" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Name" FontSize="11" Foreground="{DynamicResource Pdl.Hint}" />
                        <TextBox x:Name="LayerNameBox" FontSize="12" Height="28" Padding="6,2" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Opacity" FontSize="11"
                                       Foreground="{DynamicResource Pdl.Hint}" />
                            <TextBlock x:Name="LayerOpacityLabel" FontSize="11"
                                       Foreground="{DynamicResource Pdl.SubtleText}" />
                        </StackPanel>
                        <Slider x:Name="LayerOpacitySlider" Minimum="0" Maximum="100" Value="100" />
                    </StackPanel>
                </StackPanel>

                <ListBox x:Name="LayerList" Background="Transparent"
                         BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="1" />
            </DockPanel>
        </Border>

        <controls:PaintCanvasView x:Name="PaintView" />
    </DockPanel>
</Window>
